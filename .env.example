# ── Meme Radar configuration ─────────────────────────────────────────────
# Copy to .env and adjust. Every value is optional; sane defaults are built in.

# Robinhood Chain RPC (HTTP). A private endpoint gives fresher, more reliable data.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# WebSocket endpoint for the live feed. Set to "off" to force HTTP polling.
RPC_WS_URL=wss://robinhood-rpc.publicnode.com

# ── Observation window / performance ─────────────────────────────────────
# RADAR_POLL_MS=500          # poll interval when running without websockets
# RADAR_HISTORY_BLOCKS=400000 # deployer-history lookback depth
# RADAR_EARLY_BLOCKS=600      # early-buyer observation window
# RADAR_LOG_CHUNK=25000       # getLogs page size
# RADAR_MAX_FIRST_BUYS=1000   # cap on decoded early buys

# ── Quick-trade (⚡ TRADE) strip ──────────────────────────────────────────
# Hide the strip entirely:
# RADAR_FOMO=off
#
# Point the external FOMO buttons at whatever front-ends you trade on.
# Format: Name=url,Name=url   ({token} and {deployer} are substituted)
# RADAR_FOMO_APPS=Pump.fun=https://pump.fun/{token},FOMO=https://fomo.biz/token/{token}
#
# Keep button labels but disable OSC-8 clickable links:
# RADAR_NO_HYPERLINKS=1

# ── Wallet Intelligence Graph + Deployer DNA ─────────────────────────────
# Persistent memory of profiled launches (co-occurrence / repeat / DNA).
# Set to "off" to disable persistence; or point at a custom path.
# RADAR_HISTORY_FILE=.meme-radar-history.json
#
# Resolve funding sources via Blockscout (one HTTP request per early buyer).
# Enables the strongest "funded from same source" cluster signal. Off by default.
# RADAR_FUNDING=on
# RADAR_BLOCKSCOUT=https://robinhoodchain.blockscout.com
#
# Average block time (seconds) — used to render DNA block spans as human time.
# RADAR_BLOCK_SECONDS=2

# ── Output ───────────────────────────────────────────────────────────────
# Monochrome output for logs / pipes:
# NO_COLOR=1
#
# Keep quick-trade button labels but disable clickable OSC-8 links:
# RADAR_NO_HYPERLINKS=1
